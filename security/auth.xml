<openerp>
    <data>
        <record id="student_rule_self" model="ir.rule">
            <field name="name">Permisos de estudiantes para ver sus propios datos</field>
            <field name="model_id" ref="model_python_odoo8_module_student"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_rule_subject" model="ir.rule">
            <field name="name">Permiso de estudiantes para ver sus materias</field>
            <field name="model_id" ref="model_python_odoo8_module_subject"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_rule_classroom" model="ir.rule">
            <field name="name">Permiso de estudiantes para ver sus aulas</field>
            <field name="model_id" ref="model_python_odoo8_module_classroom"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_rule_itinerary" model="ir.rule">
            <field name="name">Permiso de estudiantes para ver su itinerario</field>
            <field name="model_id" ref="model_python_odoo8_module_itinerary"/>
            <field name="domain_force">[('student_ids.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="teacher_rule_self" model="ir.rule">
            <field name="name">Permiso de profesor para ver solo su propio registro</field>
            <field name="model_id" ref="model_python_odoo8_module_teacher"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
        </record>
    </data>
</openerp>