<openerp>
    <data>
        <record id="student_auth_student" model="ir.rule">
            <field name="name">Permisos de estudiantes para ver sus propios datos</field>
            <field name="model_id" ref="model_python_odoo8_module_student"/>
            <field name="domain_force">[('user_id.id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_auth_schedule" model="ir.rule">
            <field name="name">Permiso de estudiantes para ver sus horarios</field>
            <field name="model_id" ref="model_python_odoo8_module_schedule"/>
            <field name="domain_force">[('student_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_auth_exam" model="ir.rule">
            <field name="name">Estudiante solo ve exámenes de sus materias</field>
            <field name="model_id" ref="model_python_odoo8_module_exam"/>
            <field name="domain_force">[('subject_id.schedule_ids.student_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <record id="student_auth_result" model="ir.rule">
            <field name="name">Estudiante solo ve/crea su resultado</field>
            <field name="model_id" ref="model_python_odoo8_module_result"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.student_role_group'))]"/>
        </record>

        <!-- AUTH TEACHER -->
        <record id="teacher_auth_teacher" model="ir.rule">
            <field name="name">Permiso de profesor para ver su propio registro</field>
            <field name="model_id" ref="model_python_odoo8_module_teacher"/>
            <field name="domain_force">[('email','=',user.login)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
        </record>

        <record id="teacher_auth_subject" model="ir.rule">
            <field name="name">Permiso de profesor para ver todas y editar solo su materia</field>
            <field name="model_id" ref="model_python_odoo8_module_subject"/>
            <field name="domain_force">[('teacher_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="teacher_auth_exam" model="ir.rule">
            <field name="name">Permiso de profesor para ver y editar sus examenes</field>
            <field name="model_id" ref="model_python_odoo8_module_exam"/>
            <field name="domain_force">[('subject_id.teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
        </record>

        <record id="teacher_auth_result" model="ir.rule">
            <field name="name">Permiso de profesor para solo ver resultados de sus exámenes</field>
            <field name="model_id" ref="model_python_odoo8_module_result"/>
            <field name="domain_force">[('exam_id.subject_id.teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
        </record>

        <record id="teacher_auth_schedule_read" model="ir.rule">
            <field name="name">Permiso de profesor para ver todos los horarios</field>
            <field name="model_id" ref="model_python_odoo8_module_schedule"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="teacher_auth_schedule_write" model="ir.rule">
            <field name="name">Permiso de profesor para solo modificar sus horarios</field>
            <field name="model_id" ref="model_python_odoo8_module_schedule"/>
            <field name="domain_force">[('subject_id.teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('python_odoo8_module.teacher_role_group'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</openerp>