<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="exam_tree_view" model="ir.ui.view">
            <field name="name">exam.tree_view</field>
            <field name="model">python_odoo8_module.exam</field>
            <field name="arch" type="xml">
                <tree string="Exámenes">
                    <field name="name" string="Examen"/>
                    <field name="subject_id" string="Materia"/>
                    <field name="subject_id.teacher_id" string="Profesor"/>
                </tree>
            </field>
        </record>

        <record id="exam_form_view" model="ir.ui.view">
            <field name="name">exam.form_view</field>
            <field name="model">python_odoo8_module.exam</field>
            <field name="arch" type="xml">
                <form string="Detalles de examen">
                    <sheet>
                        <group>
                            <field name="name" placeholder="Examen"/>
                            <field name="subject_id" string="Materia"/>
                            <field name="subject_id.teacher_id" string="Profesor"/>
                        </group>
                        <notebook>
                            <page string="Preguntas">
                                <field name="question_ids" context="{'default_exam_id': id}">
                                    <tree string="Preguntas" editable="bottom">
                                        <field name="sentence" string="Pregunta"/>
                                        <field name="answer_ids" widget="one2many" options="{'create': true, 'delete': true, 'edit': true}">
                                            <tree string="Respuestas" editable="bottom">
                                                <field name="response" string="Respuesta"/>
                                                <field name="correct" string="¿Correcta?"/>
                                                <field name="point" string="Puntos"/>
                                            </tree>
                                        </field>
                                    </tree>
                                </field>
                            </page>
                            <page string="Calificaciones - Participantes">
                                <field name="result_ids">
                                    <tree string="Listado de notas">
                                        <field name="student_id" string="Estudiante"/>
                                        <field name="score" string="Puntaje"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="exam_search_view" model="ir.ui.view">
            <field name="name">exam.search_view</field>
            <field name="model">python_odoo8_module.exam</field>
            <field name="arch" type="xml">
                <search string="Buscar y encontrar">
                    <field name="name" string="Examen"/>
                    <field name="subject_id" string="Materia"/>
                    <field name="subject_id.teacher_id" string="Profesor"/>
                    <group expand="0" string="Agrupar Por">
                        <filter string="Materia" context="{'group_by':'subject_id'}"/>
                        <filter string="Profesor" context="{'group_by':'subject_id.teacher_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="exam_actions_administrator" model="ir.actions.act_window">
            <field name="name">Examenes</field>
            <field name="res_model">python_odoo8_module.exam</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="exam_tree_view"/>
        </record>

        <record id="exam_actions_teacher" model="ir.actions.act_window">
            <field name="name">Examenes</field>
            <field name="res_model">python_odoo8_module.exam</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="exam_tree_view"/>
        </record>

        <record id="exam_actions_student" model="ir.actions.act_window">
            <field name="name">Examenes</field>
            <field name="res_model">python_odoo8_module.exam</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="exam_tree_view"/>
        </record>
    </data>
</openerp>