        <menuitem id="submenu_exam_administrator" name="Exámenes" parent="primary_menu_administrator" action="exam_actions_administrator" groups="python_odoo8_module.admin_role_group"/>
        <menuitem id="submenu_result_administrator" name="Resultados de exámenes" parent="primary_menu_administrator" action="result_actions_administrator" groups="python_odoo8_module.admin_role_group"/>

        <!-- Menús Profesor -->
        <menuitem id="primary_menu_teacher" name="Administración Estudiantil" sequence="2"/>
        <menuitem id="submenu_student_teacher" name="Estudiantes" parent="primary_menu_teacher" action="student_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_teacher_teacher" name="Mi Información" parent="primary_menu_teacher" action="teacher_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_subject_teacher" name="Materias" parent="primary_menu_teacher" action="subject_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_classroom_teacher" name="Aulas" parent="primary_menu_teacher" action="classroom_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_schedule_teacher" name="Agenda académica" parent="primary_menu_teacher" action="schedule_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_exam_teacher" name="Exámenes" parent="primary_menu_teacher" action="exam_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>
        <menuitem id="submenu_result_teacher" name="Resultados de exámenes" parent="primary_menu_teacher" action="result_actions_teacher" groups="python_odoo8_module.teacher_role_group"/>

