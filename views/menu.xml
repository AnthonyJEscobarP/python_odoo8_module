        <menuitem id="primary_menu_student" name="Perfil académico" sequence="3"/>
        <menuitem id="submenu_student_student" name="Mi Información" parent="primary_menu_student" action="student_actions_student" groups="python_odoo8_module.student_role_group"/>
        <menuitem id="submenu_subject_student" name="Materias" parent="primary_menu_student" action="subject_actions_student" groups="python_odoo8_module.student_role_group"/>
