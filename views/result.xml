<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="result_tree_view" model="ir.ui.view">
            <field name="name">result.tree_view</field>
            <field name="model">python_odoo8_module.result</field>
            <field name="arch" type="xml">
                <tree string="Nota de examenes">
                    <field name="student_id" string="Estudiante"/>
                    <field name="exam_id.subject_id.teacher_id" string="Profesor"/>
                    <field name="exam_id.subject_id" string="Materia"/>
                    <field name="exam_id" string="Examen"/>
                    <field name="score" string="Puntaje"/>
                </tree>
            </field>
        </record>

        <record id="result_form_view" model="ir.ui.view">
            <field name="name">result.form_view</field>
            <field name="model">python_odoo8_module.result</field>
            <field name="arch" type="xml">
                <form string="Detalles">
                    <sheet>
                        <group>
                            <field name="student_id" string="Estudiante"/>
                            <field name="exam_id.subject_id" string="Materia"/>
                            <field name="exam_id.subject_id.teacher_id" string="Profesor"/>
                            <field name="exam_id" string="Examen"/>
                            <field name="answer_ids" widget="one2many" options="{'create': false, 'delete': false, 'edit': false}">
                                <tree string="Respuestas seleccionadas" decoration-success="correct" decoration-danger="not correct">
                                    <field name="response" string="Respuesta"/>
                                    <field name="correct" string="¿Correcta?"/>
                                    <field name="point" string="Puntos"/>
                                </tree>
                            </field>
                            <field name="score" string="Puntaje"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="result_search_view" model="ir.ui.view">
            <field name="name">result.search_view</field>
            <field name="model">python_odoo8_module.result</field>
            <field name="arch" type="xml">
                <search string="Buscar y encontrar">
                    <field name="student_id" string="Estudiante"/>
                    <field name="exam_id" string="Examen"/>
                    <field name="exam_id.subject_id" string="Materia"/>
                    <field name="exam_id.subject_id.teacher_id" string="Profesor"/>
                    <group expand="0" string="Agrupar Por">
                        <filter string="Materia" context="{'group_by':'exam_id.subject_id'}"/>
                        <filter string="Estudiante" context="{'group_by':'student_id'}"/>
                        <filter string="Examen" context="{'group_by':'exam_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="result_actions_administrator" model="ir.actions.act_window">
            <field name="name">Resultados de exámenes</field>
            <field name="res_model">python_odoo8_module.result</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="result_tree_view"/>
        </record>

        <record id="result_actions_teacher" model="ir.actions.act_window">
            <field name="name">Resultados de exámenes</field>
            <field name="res_model">python_odoo8_module.result</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="result_tree_view"/>
        </record>

        <record id="result_actions_student" model="ir.actions.act_window">
            <field name="name">Mis resultados</field>
            <field name="res_model">python_odoo8_module.result</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="result_tree_view"/>
        </record>
    </data>
</openerp>