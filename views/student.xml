<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="student_tree_view" model="ir.ui.view">
            <field name="name">student.tree_view</field>
            <field name="model">python_odoo8_module.student</field>
            <field name="arch" type="xml">
                <tree string="Listado estudiantes">
                    <field name="name" string="Estudiante"/>
                    <field name="age" string="Edad"/>
                    <field name="card" string="Carnet"/>
                    <field name="email" string="Correo"/>
                    <field name="grade" string="Grado"/>
                    <field name="section" string="Seccion"/>
                </tree>
            </field>
        </record>

        <record id="student_form_view" model="ir.ui.view">
            <field name="name">student.form_view</field>
            <field name="model">python_odoo8_module.student</field>
            <field name="arch" type="xml">
                <form string="Informacion personal">
                    <sheet>
                        <group>
                            <group>
                                <field name="photo" widget="image" class="oe_avatar" style="height:140px;width:140px"/>
                            </group>
                            <field name="name" placeholder="Estudiante"/>
                            <field name="card" readonly="1" placeholder="Carnet"/>
                            <field name="age" placeholder="Edad"/>
                            <field name="email" placeholder="Correo electronico"/>
                        </group>
                        <notebook>
                            <page string="Informacion Académica">
                                <group>
                                    <field name="grade" placeholder="Grado"/>
                                    <field name="section" placeholder="Seccion"/>
                                </group>
                                <group>
                                    <field name="schedule_ids" widget="many2many_list">
                                        <tree string="Horarios de estudiante">
                                            <field name="day" string="Dia"/>
                                            <field name="hour" string="Hora"/>
                                            <field name="subject_id" string="Materia"/>
                                            <field name="classroom_id" string="Aula"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="student_search_view" model="ir.ui.view">
            <field name="name">student.search_view</field>
            <field name="model">python_odoo8_module.student</field>
            <field name="arch" type="xml">
                <search string="Buscar y encontrar">
                    <field name="name" string="Estudiante"/>
                    <field name="card" string="Carnet"/>
                    <field name="email" string="Correo"/>
                    <field name="grade" string="Grado"/>
                    <field name="section" string="Seccion"/>
                    <field name="schedule_ids" string="Periodo"/>
                    <filter string="Inscritos" name="with_schedule" domain="[('schedule_ids','!=',False)]"/>
                    <filter string="No Inscritos" name="without_schedule" domain="[('schedule_ids','=',False)]"/>
                    <group expand="0" string="Agrupar Por">
                        <filter string="Grado" context="{'group_by':'grade'}"/>
                        <filter string="Seccion" context="{'group_by':'section'}"/>
                        <filter string="Periodos" context="{'group_by':'schedule_ids'}"/>
                        <filter string="Grado y Seccion" context="{'group_by':'grade,section'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</openerp>
