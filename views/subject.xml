<openerp>
    <data>
        <record id="subject_tree_view" model="ir.ui.view">
            <field name="name">subject.tree_view</field>
            <field name="model">python_odoo8_module.subject</field>
            <field name="arch" type="xml">
                <tree string="Listado - materias">
                    <field name="name" string="Materia"/>
                    <field name="description" string="Descripcion"/>
                    <field name="teacher_id" string="Profesor"/>
                </tree>
            </field>
        </record>

        <record id="subject_form_view" model="ir.ui.view">
            <field name="name">subject.form_view</field>
            <field name="model">python_odoo8_module.subject</field>
            <field name="arch" type="xml">
                <form string="Información de Materia">
                    <sheet>
                        <group>
                            <field name="teacher_id" string="Profesor"/>
                            <field name="name" placeholder="Materia"/>
                            <field name="description" placeholder="Descripción"/>
                        </group>
                        <notebook>
                            <page string="Horarios de clase">
                                <field name="schedule_ids">
                                    <tree string="Periodos de la Materia">
                                        <field name="day" string="Día"/>
                                        <field name="hour" string="Hora"/>
                                        <field name="classroom_id" string="Aula"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Estudiantes Inscritos">
                                <field name="schedule_ids.student_ids" widget="many2many_list">
                                    <tree string="Estudiantes Inscritos">
                                        <field name="card" string="Carnet"/>
                                        <field name="name" string="Nombre"/>
                                        <field name="grade" string="Grado"/>
                                        <field name="section" string="Sección"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Exámenes">
                                <field name="exam_ids">
                                    <tree string="Exámenes de la materia">
                                        <field name="name" string="Examen"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="subject_search_view" model="ir.ui.view">
            <field name="name">subject.search_view</field>
            <field name="model">python_odoo8_module.subject</field>
            <field name="arch" type="xml">
                <search string="Buscar y encontrar">
                    <field name="name" string="Materia"/>
                    <field name="teacher_id" string="Profesor"/>
                    <field name="schedule_ids.hour" string="Hora"/>
                    <field name="schedule_ids.classroom_id" string="Aula"/>

                    <filter string="Con Horarios" name="with_itineraries" domain="[('schedule_ids', '!=', False)]"/>
                    <filter string="Sin Horarios" name="without_itineraries" domain="[('schedule_ids', '=', False)]"/>

                    <group expand="0" string="Agrupar Por">
                        <filter string="Profesor" context="{'group_by':'teacher_id'}"/>
                        <filter string="Aula" context="{'group_by':'schedule_ids.classroom_id'}"/>
                        <filter string="Día" context="{'group_by':'schedule_ids.day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="subject_actions_teacher" model="ir.actions.act_window">
            <field name="name">Materias</field>
            <field name="res_model">python_odoo8_module.subject</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="subject_tree_view"/>
        </record>

        <record id="subject_actions_student" model="ir.actions.act_window">
            <field name="name">Materias</field>
            <field name="res_model">python_odoo8_module.subject</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="subject_tree_view"/>
        </record>
    </data>
</openerp>
