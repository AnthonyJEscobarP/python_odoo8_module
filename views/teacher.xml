<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="teacher_tree_view" model="ir.ui.view">
            <field name="name">teacher.tree_view</field>
            <field name="model">python_odoo8_module.teacher</field>
            <field name="arch" type="xml">
                <tree string="Profesores">
                    <field name="name" string="Profesor"/>
                    <field name="age" string="Edad"/>
                    <field name="email" string="Correo"/>
                    <field name="subject_id" string="Materia"/>
                </tree>
            </field>
        </record>

        <record id="teacher_form_view" model="ir.ui.view">
            <field name="name">teacher.form_view</field>
            <field name="model">python_odoo8_module.teacher</field>
            <field name="arch" type="xml">
                <form string="Informacion personal">
                    <sheet>
                        <group>
                            <field name="photo" widget="image" class="oe_avatar" style="height:140px;width:140px"/>
                        </group>
                        <group>
                            <field name="user_id" string="Usuario de Odoo" readonly="1"/>
                            <field name="name" placeholder="Profesor"/>
                            <field name="age" placeholder="Edad"/>
                            <field name="email" placeholder="Correo Electrónico"/>
                        </group>
                        <notebook>
                            <page string="Horarios de clase">
                                <group>
                                    <field name="subject_id" string="Materia a cargo"/>
                                    <field name="schedule_ids" widget="one2many_list" readonly="1">
                                        <tree string="Horarios de clase">
                                            <field name="day" string="Dia"/>
                                            <field name="hour" string="Hora"/>
                                            <field name="classroom_id" string="Aula"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="teacher_search_view" model="ir.ui.view">
            <field name="name">teacher.search_view</field>
            <field name="model">python_odoo8_module.teacher</field>
            <field name="arch" type="xml">
                <search string="Buscar y encontrar">
                    <field name="name" string="Nombre"/>
                    <field name="email" string="Correo"/>
                </search>
            </field>
        </record>
    </data>
</openerp>