<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="student_schedule_wizard_actions" model="ir.actions.act_window">
            <field name="name">Generar Horario</field>
            <field name="res_model">python_odoo8_module.student_schedule_wizard</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_student_id': active_id}</field>
        </record>

        <record id="student_schedule_wizard_inherit" model="ir.ui.view">
            <field name="name">student_schedule_wizard_button</field>
            <field name="model">python_odoo8_module.student</field>
            <field name="inherit_id" ref="python_odoo8_module.student_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="before">
                    <button name="%(python_odoo8_module.student_schedule_wizard_actions)d" string="Generar Horario PDF" type="action" class="oe_highlight" groups="python_odoo8_module.admin_role_group,
                        python_odoo8_module.teacher_role_group,
                        python_odoo8_module.student_role_group"/>
                </xpath>
            </field>
        </record>

        <record id="student_schedule_wizard_form_view" model="ir.ui.view">
            <field name="name">student_schedule_wizard.form</field>
            <field name="model">python_odoo8_module.student_schedule_wizard</field>
            <field name="arch" type="xml">
                <form string="Generar Horario de Clases">
                    <group>
                        <field name="student_id"/>
                        <field name="file_data" filename="file_name" widget="binary" readonly="1"/>
                    </group>
                    <footer>
                        <button name="generate_schedule_pdf" string="Generar Horario PDF" type="object" class="oe_highlight"/>
                        <button string="Cerrar" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</openerp>