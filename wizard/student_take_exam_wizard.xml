<record id="view_student_take_exam_wizard_form" model="ir.ui.view">
    <field name="name">student.take.exam.wizard.form</field>
    <field name="model">python_odoo8_module.student_take_exam_wizard</field>
    <field name="arch" type="xml">
        <form string="Realizar Examen">
            <field name="exam_id"/>
            <field name="student_id" invisible="1"/>
            <field name="answer_ids" widget="many2many_tags"/>
            <footer>
                <button string="Finalizar Examen" type="object" name="submit_exam" class="btn-primary"/>
                <button string="Cancelar" class="oe_link" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
